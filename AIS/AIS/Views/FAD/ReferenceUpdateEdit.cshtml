@model int
@{
    ViewData["Title"] = "Update Reference";
    Layout = "_Layout";
}
<h4>Update Reference</h4>
<div id="paraText" class="mb-3"></div>
<ul id="refList" class="list-group mb-3"></ul>
<button class="btn btn-success mb-3" id="saveBtn">Save</button>

<div id="searchSection">
    <select id="refType" class="form-select mb-2">
        <option value="Manual">Manual</option>
        <option value="Policy">Policy</option>
        <option value="Circular">Circular</option>
    </select>
    <input id="keyword" class="form-control mb-2" placeholder="keyword" />
    <button class="btn btn-primary" id="searchBtn">Search</button>
</div>
<table class="table" id="resultTbl">
    <thead>
        <tr>
            <th>TITLE</th>
            <th>REFERENCE ID</th>
            <th>INSTRUCTIONS DETAILS</th>
            <th>KEYWORDS</th>
            <th>View Circular</th>
            <th>Action</th>

        </tr>
    </thead>
    <tbody></tbody>
</table>
<script>
    $(function(){
        var comId = @Model;
        var refs = [];

        $.get(g_asiBaseURL + '/ApiCalls/GetParaReferenceData', { comId: comId }, function(d){
            $('#paraText').text(d.paraText);
            refs = d.references || [];
            renderRefs();
        });

        $('#searchBtn').click(function(){
            $.post(g_asiBaseURL+'/ApiCalls/SearchReferences',{referenceType:$('#refType').val(),keyword:$('#keyword').val()},function(d){
                var body=$('#resultTbl tbody');body.empty();
                $.each(d,function(i,it){
                    body.append('<tr>'+
                        '<td>'+it.title+'</td>'+
                        '<td>'+it.referenceId+'</td>'+
                        '<td>'+it.instructionsdetails+'</td>'+
                        '<td>'+it.keywords+'</td>'+
                        '<td><button class="view btn btn-sm btn-secondary" data-url="'+it.referenceurl+'">View</button></td>'+
                        '<td><button class="attach btn btn-sm btn-primary" data-id="'+it.referenceId+'">Attach</button></td>'+
                        '</tr>');
                });
            });
        });

        $(document).on('click','.attach',function(){
            var ref=$(this).data('id');
            if($.inArray(ref, refs) === -1){
                refs.push(ref);
                renderRefs();
            }
        });

        $(document).on('click','.remove-ref',function(){
            var id=$(this).data('id');
            refs = $.grep(refs,function(v){ return v!=id; });
            renderRefs();
        });

        $(document).on('click','.view',function(){
            var url=$(this).data('url');
            window.open(url,'_blank');
        });

        $('#saveBtn').click(function(){
            $.post(g_asiBaseURL + '/ApiCalls/SaveParaReferences', { comId: comId, references: refs }, function(){
                window.location.href = g_asiBaseURL + '/FAD/ReferenceUpdateList';
            });
        });

        function renderRefs(){
            var ul=$('#refList'); ul.empty();
            $.each(refs,function(i,r){
                ul.append('<li class="list-group-item">'+r+' <button type="button" class="btn btn-danger btn-sm float-end remove-ref" data-id="'+r+'">Delete</button></li>');
            });
        }
    });
</script>
