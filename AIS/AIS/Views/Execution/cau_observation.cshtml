@using Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout"; // adjust if different
    ViewData["Title"] = "CAU Observation";
}

<div class="container-fluid">
    <h2 class="mt-3 mb-3">CAU Observation - Draft Para</h2>

    <form asp-action="SaveCauObservation" asp-controller="Execution" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-2">
            <label class="form-label" for="AuditParaHtml">Draft Para</label>
            <textarea class="form-control" id="AuditParaHtml" name="AuditParaHtml" rows="15">@Html.Raw(Model?.AuditParaHtml ?? "")</textarea>
            <div class="form-text">Use the toolbar to format text, insert tables, and add page breaks.</div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-save"></i> Save
            </button>
            <button type="button" class="btn btn-outline-secondary" onclick="window.print()" title="Browser print">
                <i class="fa fa-print"></i> Print Page
            </button>
            <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#customPrintModal">
                <i class="fa fa-print"></i> Print… (Custom)
            </button>
        </div>
    </form>
</div>

<link rel="stylesheet" href="~/css/print.css" />

<script src="~/lib/ckeditor4/ckeditor/ckeditor.js"></script>
<script>
  (function () {
    // Basic CKEditor 4 replace with Word-like toolbar
    CKEDITOR.replace('AuditParaHtml', {
      height: 500,
      // Enable a rich toolbar similar to Word:
      // Full build already includes many plugins; we ensure key ones are active in toolbar.
      toolbar: [
        { name: 'document', items: ['Source','Preview','Print','PageBreak'] },
        { name: 'clipboard', items: ['Undo','Redo','Find','Replace','SelectAll','RemoveFormat'] },
        { name: 'styles', items: ['Format','Font','FontSize'] },
        { name: 'basicstyles', items: ['Bold','Italic','Underline','Strike','Subscript','Superscript','CopyFormatting'] },
        { name: 'colors', items: ['TextColor','BGColor'] },
        { name: 'paragraph', items: ['NumberedList','BulletedList','Outdent','Indent','Blockquote','JustifyLeft','JustifyCenter','JustifyRight','JustifyBlock'] },
        { name: 'insert', items: ['Table','SpecialChar','HorizontalRule','Link','Unlink'] },
        { name: 'tools', items: ['Maximize'] }
      ],
      // Improve Word paste behavior
      pasteFromWordPromptCleanup: true,
      pasteFromWordRemoveFontStyles: false,
      pasteFromWordRemoveStyles: false,
      // Keep content CSS consistent (print and on-screen)
      contentsCss: ['~/css/print.css'],
      // Optional: allow more HTML if needed
      extraAllowedContent: true,
      removePlugins: 'cloudservices,easyimage',
      // Optional: set default block
      // enterMode: CKEDITOR.ENTER_P,
    });

    // --- Custom Print Modal support (optional) ---
    // Uses CKEditor data and opens a clean print window with header/margins/watermark.
    document.addEventListener('DOMContentLoaded', function () {
      var form = document.getElementById('customPrintForm');
      if (!form) return;
      form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        var editor = CKEDITOR.instances['AuditParaHtml'];
        if (!editor) return;

        var size = document.getElementById('printPageSize').value || 'A4';
        var margin = document.getElementById('printMargin').value || '20';
        var header = document.getElementById('printHeader').value || '';
        var watermark = document.getElementById('printWatermark').value || '';
        var html = editor.getData();

        var win = window.open('', '_blank');
        win.document.write('<!doctype html><html><head><meta charset="utf-8"><title>Print</title>');
        win.document.write('<style>@page { size: ' + size + '; margin: ' + margin + 'mm; } @media print { .no-print { display:none } } body { font-family: "Times New Roman", serif; font-size: 12pt; line-height: 1.4; } header.print-header { position: fixed; top: 0; left:0; right:0; text-align:center; padding:6mm 0; } main { margin: 20mm 0; }</style>');
        win.document.write('<link rel="stylesheet" href="/css/print.css">');
        win.document.write('</head><body>');
        if (header) win.document.write('<header class="print-header">' + header.replace(/</g,'&lt;') + '</header>');
        if (watermark) {
          var wm = watermark.replace(/'/g, "\\'");
          win.document.write('<style>body::before{content:\'' + wm + '\';position:fixed;top:40%;left:50%;transform:translate(-50%,-50%) rotate(-30deg);opacity:.08;font-size:120pt;pointer-events:none;white-space:nowrap;}</style>');
        }
        win.document.write('<main>' + html + '</main><script>window.onload=function(){window.print();}<\/script></body></html>');
        win.document.close();

        var modalEl = document.getElementById('customPrintModal');
        if (window.bootstrap && bootstrap.Modal && modalEl) {
          bootstrap.Modal.getOrCreateInstance(modalEl).hide();
        }
      });
    });
  })();
</script>

<!-- Custom Print Modal (Bootstrap 5) -->
<div class="modal fade" id="customPrintModal" tabindex="-1" aria-labelledby="customPrintModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="customPrintForm">
        <div class="modal-header">
          <h5 class="modal-title" id="customPrintModalLabel">Custom Print Options</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label" for="printPageSize">Page size</label>
            <select id="printPageSize" class="form-select">
              <option value="A4" selected>A4</option>
              <option value="Letter">Letter</option>
              <option value="Legal">Legal</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label" for="printMargin">Margin (mm)</label>
            <input id="printMargin" type="number" class="form-control" min="0" value="20" />
          </div>
          <div class="mb-3">
            <label class="form-label" for="printHeader">Header text (optional)</label>
            <input id="printHeader" type="text" class="form-control" placeholder="e.g., IA Wing – Confidential" />
          </div>
          <div class="mb-3">
            <label class="form-label" for="printWatermark">Watermark (optional)</label>
            <input id="printWatermark" type="text" class="form-control" placeholder="e.g., DRAFT" />
          </div>
          <div class="alert alert-info">
            Tip: Use <b>Insert → Page Break</b> in the toolbar to force a new printed page.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Print</button>
        </div>
      </form>
    </div>
  </div>
</div>
